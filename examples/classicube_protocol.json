  "play": {
    "toServer": {
      "types": {
        "packet": [
          "container",
          [
            {
              "name": "name",
              "type": [
                "mapper",
                {
                  "type": "u8",
                  "mappings": {
                    "0x00": "identification",
                    "0x05": "set_block",
                    "0x08": "position_orientation",
                    "0x0d": "message",
                    "0x10": "ext_info",
                    "0x11": "ext_entry",
                    "0x12": "custom_block_support_level"
                  }
                }
              ]
            },
            {
              "name": "params",
              "type": [
                "switch",
                {
                  "compareTo": "name",
                  "fields": {
                    "identification": "packet_identification",
                    "set_block": "packet_set_block_client",
                    "position_orientation": "packet_position_orientation",
                    "message": "packet_message",
                    "ext_info": "packet_ext_info",
                    "ext_entry": "packet_ext_entry",
                    "custom_block_support_level": "packet_custom_block_support_level"
                  }
                }
              ]
            }
          ]
        ]
      }
    },
    "toClient": {
      "types": {
        "packet": [
          "container",
          [
            {
              "name": "name",
              "type": [
                "mapper",
                {
                  "type": "u8",
                  "mappings": {
                    "0x00": "identification",
                    "0x01": "ping",
                    "0x02": "level_initialize",
                    "0x03": "level_data_chunk",
                    "0x04": "level_finalize",
                    "0x06": "set_block",
                    "0x07": "spawn_player",
                    "0x08": "position_orientation",
                    "0x09": "position_update",
                    "0x0a": "position_update_only",
                    "0x0b": "orientation_update",
                    "0x0c": "despawn_player",
                    "0x0d": "message",
                    "0x0e": "disconnect",
                    "0x0f": "update_user_type",
                    "0x10": "ext_info",
                    "0x11": "ext_entry",
                    "0x12": "custom_block_support_level",
                    "0x14": "held_block",
                    "0x16": "ext_add_player_name",
                    "0x18": "ext_remove_player_name",
                    "0x1c": "ext_click_distance"
                  }
                }
              ]
            },
            {
              "name": "params",
              "type": [
                "switch",
                {
                  "compareTo": "name",
                  "fields": {
                    "identification": "packet_identification",
                    "ping": "packet_ping",
                    "level_initialize": "packet_level_initialize",
                    "level_data_chunk": "packet_level_data_chunk",
                    "level_finalize": "packet_level_finalize",
                    "set_block": "packet_set_block_server",
                    "spawn_player": "packet_spawn_player",
                    "position_orientation": "packet_position_orientation",
                    "position_update": "packet_position_update",
                    "position_update_only": "packet_position_update_only",
                    "orientation_update": "packet_orientation_update",
                    "despawn_player": "packet_despawn_player",
                    "message": "packet_message",
                    "disconnect": "packet_disconnect",
                    "update_user_type": "packet_update_user_type",
                    "ext_info": "packet_ext_info",
                    "ext_entry": "packet_ext_entry",
                    "custom_block_support_level": "packet_custom_block_support_level",
                    "held_block": "packet_held_block",
                    "ext_add_player_name": "packet_ext_add_player_name",
                    "ext_remove_player_name": "packet_ext_remove_player_name",
                    "ext_click_distance": "packet_ext_click_distance"
                  }
                }
              ]
            }
          ]
        ]
      }
    }
  }
